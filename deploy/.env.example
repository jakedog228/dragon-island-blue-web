# Copy to deploy/.env and fill in. `deploy/.env` is gitignored; never commit a filled copy.
#
#   cp deploy/.env.example deploy/.env
#   docker compose -f deploy/compose.yaml --env-file deploy/.env up -d --build

# =================================================================================================
# Required
# =================================================================================================

# Public hostname Caddy issues a certificate for. Must already resolve to this host, and ports
# 80/443 must be reachable, or the ACME challenge fails.
DIB_PUBLIC_HOST=example.com
# One canonical HTTPS origin, even when DIB_PUBLIC_HOST contains comma-separated Caddy aliases.
DIB_GAME_PUBLIC_ORIGIN=https://example.com
# Separate author site: point its DNS at the same VM before deploying. Never use DIB_PUBLIC_HOST.
DIB_COMMUNITY_HOST=community.example.com

# Contact address for Let's Encrypt expiry notices.
DIB_ACME_EMAIL=operator@example.com

# Host path to the extracted game resource tree (the directory containing Monsters.json,
# Worlds.json, ...). Mounted READ-ONLY into the server; never copied into an image.
# This is operator-supplied content and stays outside the repository's distribution boundary.
DIB_EXTRACTED_DATA_HOST_PATH=/srv/dib/extracted/data

# Host path to the HMAC secret file, at least 32 bytes, mode 600.
# Generate with: deploy/generate-secret.sh /srv/dib/secrets/hmac
#
# WARNING: this value IS the player identity namespace. playerId = HMAC(secret, loginToken), so
# changing it orphans every stored slot. See "Rotating the HMAC secret" in docs/deployment.md.
DIB_HMAC_SECRET_HOST_PATH=/srv/dib/secrets/hmac

# Host directory that receives state snapshots. Put it on different storage from the Docker volume;
# a backup on the same disk does not survive the failure it exists for.
DIB_BACKUP_HOST_PATH=/srv/dib/backups

# =================================================================================================
# Optional
# =================================================================================================

# debug | info | warn | error
# `info` logs one record per real API request. `debug` additionally logs the health/readiness probes,
# which the proxy and container healthcheck poll roughly every six seconds -- useful when debugging a
# probe, far too noisy to leave on. Access logs land on the dib_game-logs and dib_caddy-logs volumes;
# read them with `deploy/traffic-report.sh`.
DIB_GAME_LOG_LEVEL=info

# Rotation for the durable game-server log. The path itself is set by compose and is not an operator
# knob; these bound how much history the volume keeps.
DIB_GAME_LOG_FILE_MAX_BYTES=33554432
DIB_GAME_LOG_FILE_KEEP=5

DIB_GAME_START_WORLD=World_1-1
DIB_GAME_START_TOWN=First_City

# Rate limits. Session is the unauthenticated login route, keyed by client address; command is
# authenticated execution, keyed by player.
DIB_GAME_SESSION_RATE_PER_MINUTE=20
DIB_GAME_SESSION_RATE_BURST=10
DIB_GAME_REGISTRATION_ENABLED=true
# Exhibition matches for Offline and Official parties; independent of account registration.
DIB_PVP_ENABLED=true
DIB_GAME_REGISTRATION_RATE_PER_MINUTE=0.2
DIB_GAME_REGISTRATION_RATE_BURST=1
DIB_GAME_MAX_ACCOUNTS=10000
DIB_GAME_SCOREBOARD_RATE_PER_MINUTE=60
DIB_GAME_SCOREBOARD_RATE_BURST=20
DIB_GAME_COMMAND_RATE_PER_MINUTE=600
DIB_GAME_COMMAND_RATE_BURST=120

DIB_GAME_MEMORY_LIMIT=1g

# Backup cadence and retention.
DIB_BACKUP_INTERVAL_SECONDS=86400
DIB_BACKUP_KEEP_DAILY=7
DIB_BACKUP_KEEP_WEEKLY=4

# =================================================================================================
# Only for a split-origin deployment
# =================================================================================================
# Leave unset for the standard single-origin stack: the server skips CORS entirely for same-host
# requests, so an allowlist entry is unnecessary and only widens the surface. Set this ONLY if the
# client is genuinely served from a different origin. Must be https in production.
# DIB_GAME_ALLOWED_ORIGINS=https://play.example.com
